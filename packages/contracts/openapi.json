{
  "components": {
    "schemas": {
      "AdminRole": {
        "enum": [
          "editor",
          "reviewer",
          "admin"
        ],
        "title": "AdminRole",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Membership": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "role": {
            "$ref": "#/components/schemas/AdminRole"
          },
          "user_id": {
            "pattern": "^[0-9a-fA-F-]{36}$",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "role"
        ],
        "title": "Membership",
        "type": "object"
      },
      "Patch": {
        "additionalProperties": false,
        "properties": {
          "changes": {
            "additionalProperties": true,
            "title": "Changes",
            "type": "object"
          },
          "revision": {
            "minimum": 1.0,
            "title": "Revision",
            "type": "integer"
          }
        },
        "required": [
          "revision",
          "changes"
        ],
        "title": "Patch",
        "type": "object"
      },
      "ReleaseCreate": {
        "additionalProperties": false,
        "properties": {
          "activate": {
            "default": true,
            "title": "Activate",
            "type": "boolean"
          },
          "include_drafts": {
            "default": false,
            "title": "Include Drafts",
            "type": "boolean"
          },
          "notes": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "version": {
            "maxLength": 64,
            "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.+-]+)?$",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "version"
        ],
        "title": "ReleaseCreate",
        "type": "object"
      },
      "SimulationCreate": {
        "additionalProperties": false,
        "properties": {
          "bath_temperature_c": {
            "anyOf": [
              {
                "maximum": 1600.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bath Temperature C"
          },
          "bath_time_min": {
            "anyOf": [
              {
                "maximum": 1440.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bath Time Min"
          },
          "hold_time_min": {
            "maximum": 1440.0,
            "minimum": 0.0,
            "title": "Hold Time Min",
            "type": "number"
          },
          "initial_condition_id": {
            "anyOf": [
              {
                "maxLength": 80,
                "pattern": "^[a-z0-9_]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Initial Condition Id"
          },
          "locale": {
            "default": "es",
            "enum": [
              "es",
              "en"
            ],
            "title": "Locale",
            "type": "string"
          },
          "material_id": {
            "enum": [
              "aisi_1045",
              "aisi_8620",
              "en_gjl_250"
            ],
            "title": "Material Id",
            "type": "string"
          },
          "prior_hold_min": {
            "anyOf": [
              {
                "maximum": 1440.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prior Hold Min"
          },
          "prior_mode": {
            "default": "reference",
            "enum": [
              "reference",
              "history",
              "theory"
            ],
            "title": "Prior Mode",
            "type": "string"
          },
          "prior_protocol_id": {
            "anyOf": [
              {
                "maxLength": 80,
                "pattern": "^[a-z0-9_]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prior Protocol Id"
          },
          "prior_temperature_c": {
            "anyOf": [
              {
                "maximum": 1600.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prior Temperature C"
          },
          "protocol_id": {
            "anyOf": [
              {
                "maxLength": 80,
                "pattern": "^[a-z0-9_]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Protocol Id"
          },
          "target_temperature_c": {
            "maximum": 1600.0,
            "minimum": 0.0,
            "title": "Target Temperature C",
            "type": "number"
          },
          "treatment_id": {
            "enum": [
              "quench",
              "temper",
              "anneal",
              "normalize",
              "austemper",
              "martemper",
              "quench_temper"
            ],
            "title": "Treatment Id",
            "type": "string"
          }
        },
        "required": [
          "material_id",
          "treatment_id",
          "target_temperature_c",
          "hold_time_min"
        ],
        "title": "SimulationCreate",
        "type": "object"
      },
      "Transition": {
        "additionalProperties": false,
        "properties": {
          "revision": {
            "minimum": 1.0,
            "title": "Revision",
            "type": "integer"
          },
          "to": {
            "enum": [
              "reviewed",
              "draft",
              "retired"
            ],
            "title": "To",
            "type": "string"
          }
        },
        "required": [
          "to",
          "revision"
        ],
        "title": "Transition",
        "type": "object"
      },
      "TutorAsk": {
        "additionalProperties": false,
        "properties": {
          "locale": {
            "default": "es",
            "enum": [
              "es",
              "en"
            ],
            "title": "Locale",
            "type": "string"
          },
          "question": {
            "maxLength": 500,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          },
          "simulation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SimulationCreate"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "question"
        ],
        "title": "TutorAsk",
        "type": "object"
      },
      "TutorExplain": {
        "additionalProperties": false,
        "properties": {
          "locale": {
            "default": "es",
            "enum": [
              "es",
              "en"
            ],
            "title": "Locale",
            "type": "string"
          },
          "simulation": {
            "$ref": "#/components/schemas/SimulationCreate"
          }
        },
        "required": [
          "simulation"
        ],
        "title": "TutorExplain",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },

# Copie este archivo como .env y ajuste los valores. NUNCA suba .env a Git.
FERROLAB_ENV=development            # development | test | production
# Sin DATABASE_URL la API funciona en modo lectura con el catálogo semilla (sin panel admin).
DATABASE_URL=postgresql://ferrolab:CAMBIAR@localhost:5432/ferrolab_dev
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Administración (Supabase Auth). Valores del panel de Supabase > Project Settings > API.
SUPABASE_URL=
SUPABASE_ANON_KEY=                  # clave pública (publishable); puede llegar al navegador
SUPABASE_JWT_ISSUER=                # p. ej. https://<proyecto>.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=                  # p. ej. https://<proyecto>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=                # solo desarrollo local o secreto heredado HS256; SOLO servidor
ADMIN_DEV_LOGIN=false               # true solo en desarrollo local
REQUIRE_DISTINCT_REVIEWER=false     # true cuando haya al menos dos personas revisoras

# Tutor IA opcional: apagado por defecto. Requiere presupuesto propio.
AI_ENABLED=false
AI_PROVIDER=none                    # none | anthropic
AI_API_KEY=                         # SOLO servidor
AI_MODEL=claude-opus-5-5
AI_DAILY_REQUEST_BUDGET=0           # 0 = ninguna llamada de pago

RATE_LIMIT_PER_MINUTE=60
SIMULATION_RATE_LIMIT_PER_MINUTE=30
TUTOR_RATE_LIMIT_PER_MINUTE=6
SERVE_WEB_APP=false               # true: la API también entrega la app web (una sola dirección)
LOG_LEVEL=INFO
